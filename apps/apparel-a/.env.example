# PostgreSQL connection string. Required.
# Local example: postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=

# Optional direct (non-pooled) connection string, used by `db:seed` / `db:reset`
# for migrations. Neon's integration injects this automatically.
DATABASE_URL_UNPOOLED=

# Commerce backend adapter. `local` (default) runs the simulated demo backend
# backed by Postgres. Set to `spree` to use the Spree Storefront API adapter.
COMMERCE_BACKEND=local
